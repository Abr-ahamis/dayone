<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_expanded_background"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Left Column -->
    <LinearLayout
        android:layout_width="148dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.2"
            android:text="DAYONE"
            android:textColor="@color/text_muted"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/streakCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/bebas_neue"
            android:includeFontPadding="false"
            android:text="12"
            android:textColor="@color/accent_blue"
            android:textSize="68sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/dm_sans_medium"
            android:letterSpacing="0.2"
            android:text="DAYS"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="9sp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/statusDot"
                android:layout_width="5dp"
                android:layout_height="5dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/dm_sans_medium"
                android:text="On streak"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/habitName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/dm_sans_medium"
            android:singleLine="true"
            android:text="No Sugar"
            android:textColor="@color/text_primary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="14dp"
        android:layout_height="match_parent"
        android:src="@android:color/transparent" />

    <!-- Right Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="0.15"
                android:text="ACTIVITY"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/activityStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/dm_sans_medium"
                android:letterSpacing="0.15"
                android:text="12"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />
        </RelativeLayout>

        <ImageView
            android:id="@+id/contribGrid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:scaleType="centerInside" />
    </LinearLayout>
</LinearLayout>
